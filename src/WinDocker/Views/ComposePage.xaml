<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinDocker.Views.ComposePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WinDocker.Core.Models"
    xmlns:table="using:WinDocker.Views.Table"
    NavigationCacheMode="Required">

    <Grid Padding="16,8,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <CommandBar
            Grid.Row="0"
            HorizontalAlignment="Left"
            Background="Transparent"
            DefaultLabelPosition="Right"
            IsOpen="False"
            OverflowButtonVisibility="Collapsed">
            <AppBarButton x:Uid="Compose_RefreshButton" Icon="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" />
            <AppBarSeparator />
            <AppBarButton x:Uid="Compose_StartButton" Icon="Play" Command="{x:Bind ViewModel.StartCommand}" />
            <AppBarButton x:Uid="Compose_StopButton" Icon="Stop" Command="{x:Bind ViewModel.StopCommand}" />
            <AppBarButton x:Uid="Compose_RestartButton" Icon="Sync" Command="{x:Bind ViewModel.RestartCommand}" />
            <AppBarButton x:Uid="Compose_DownButton" Icon="Delete" Command="{x:Bind ViewModel.DownCommand}">
                <ToolTipService.ToolTip>
                    <ToolTip x:Uid="Compose_DownToolTip" />
                </ToolTipService.ToolTip>
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Delete" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
        </CommandBar>

        <ProgressBar
            Grid.Row="1"
            VerticalAlignment="Center"
            IsIndeterminate="True"
            Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

        <StackPanel Grid.Row="2">
            <InfoBar
                x:Uid="Compose_ErrorInfoBar"
                Margin="0,8,0,0"
                Severity="Error"
                IsOpen="{x:Bind ViewModel.HasError, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
            <InfoBar
                x:Uid="Compose_StatusInfoBar"
                Margin="0,8,0,0"
                Severity="Success"
                IsOpen="{x:Bind ViewModel.HasStatus, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
        </StackPanel>

        <table:TableHeader Grid.Row="3" LayoutKey="compose" />

        <ListView
            x:Name="ItemList"
            Grid.Row="4"
            ItemsSource="{x:Bind ViewModel.Projects}"
            SelectionMode="Extended"
            ItemContainerStyle="{StaticResource TableRowStyle}"
            SelectionChanged="List_SelectionChanged"
            ContextRequested="List_ContextRequested">
            <ListView.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Uid="Compose_MenuStart" Icon="Play" Command="{x:Bind ViewModel.StartCommand}" />
                    <MenuFlyoutItem x:Uid="Compose_MenuStop" Icon="Stop" Command="{x:Bind ViewModel.StopCommand}" />
                    <MenuFlyoutItem x:Uid="Compose_MenuRestart" Icon="Sync" Command="{x:Bind ViewModel.RestartCommand}" />
                    <MenuFlyoutItem x:Uid="Compose_MenuDown" Icon="Delete" Command="{x:Bind ViewModel.DownCommand}" />
                </MenuFlyout>
            </ListView.ContextFlyout>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ComposeProjectItem">
                    <table:TableRowPanel LayoutKey="compose" ColumnSpacing="12">
                        <TextBlock table:TableRowPanel.ColumnKey="project" Text="{x:Bind Info.Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Info.Name, Mode=OneWay}" />
                        <TextBlock table:TableRowPanel.ColumnKey="status" Text="{x:Bind StatusText, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind StatusText, Mode=OneWay}" />
                        <TextBlock table:TableRowPanel.ColumnKey="services" Text="{x:Bind Info.ServicesText, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Info.ServicesText, Mode=OneWay}" />
                        <TextBlock table:TableRowPanel.ColumnKey="workingDir" Text="{x:Bind Info.WorkingDir, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Info.WorkingDir, Mode=OneWay}" />
                        <TextBlock table:TableRowPanel.ColumnKey="configFiles" Text="{x:Bind Info.ConfigFiles, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Info.ConfigFiles, Mode=OneWay}" />
                    </table:TableRowPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            x:Uid="Compose_EmptyText"
            Grid.Row="4"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            TextWrapping="Wrap"
            TextAlignment="Center"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
    </Grid>
</Page>
