<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinDocker.Views.ContainersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WinDocker.Core.Models"
    xmlns:table="using:WinDocker.Views.Table"
    NavigationCacheMode="Required">

    <Grid Padding="16,8,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <CommandBar
            Grid.Row="0"
            HorizontalAlignment="Left"
            Background="Transparent"
            DefaultLabelPosition="Right"
            IsOpen="False"
            OverflowButtonVisibility="Collapsed">
            <AppBarButton x:Uid="Containers_RefreshButton" Icon="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" />
            <AppBarSeparator />
            <AppBarButton x:Uid="Containers_StartButton" Icon="Play" Command="{x:Bind ViewModel.StartCommand}" />
            <AppBarButton x:Uid="Containers_StopButton" Icon="Stop" Command="{x:Bind ViewModel.StopCommand}" />
            <AppBarButton x:Uid="Containers_DeleteButton" Icon="Delete" Command="{x:Bind ViewModel.RemoveCommand}">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Delete" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton
                x:Uid="Containers_LogsButton"
                Icon="Document"
                IsEnabled="{x:Bind ViewModel.HasSingleSelection, Mode=OneWay}"
                Click="Logs_Click" />
            <AppBarSeparator />
            <AppBarButton x:Uid="Containers_PruneButton" Icon="Trim" Command="{x:Bind ViewModel.PruneCommand}" />
            <AppBarSeparator />
            <AppBarToggleButton
                x:Uid="Containers_ShowAllButton"
                Icon="List"
                IsChecked="{x:Bind ViewModel.ShowAll, Mode=TwoWay}" />
        </CommandBar>

        <ProgressBar
            Grid.Row="1"
            VerticalAlignment="Center"
            IsIndeterminate="True"
            Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

        <StackPanel Grid.Row="2">
            <InfoBar
                x:Uid="Containers_ErrorInfoBar"
                Margin="0,8,0,0"
                Severity="Error"
                IsOpen="{x:Bind ViewModel.HasError, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
            <InfoBar
                x:Uid="Containers_StatusInfoBar"
                Margin="0,8,0,0"
                Severity="Success"
                IsOpen="{x:Bind ViewModel.HasStatus, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
        </StackPanel>

        <table:TableHeader Grid.Row="3" LayoutKey="containers" />

        <ListView
            x:Name="ItemList"
            Grid.Row="4"
            ItemsSource="{x:Bind ViewModel.Containers}"
            SelectionMode="Extended"
            ItemContainerStyle="{StaticResource TableRowStyle}"
            SelectionChanged="List_SelectionChanged"
            ContextRequested="List_ContextRequested">
            <ListView.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Uid="Containers_MenuStart" Icon="Play" Command="{x:Bind ViewModel.StartCommand}" />
                    <MenuFlyoutItem x:Uid="Containers_MenuStop" Icon="Stop" Command="{x:Bind ViewModel.StopCommand}" />
                    <MenuFlyoutItem x:Uid="Containers_MenuDelete" Icon="Delete" Command="{x:Bind ViewModel.RemoveCommand}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        x:Uid="Containers_MenuLogs"
                        Icon="Document"
                        IsEnabled="{x:Bind ViewModel.HasSingleSelection, Mode=OneWay}"
                        Click="Logs_Click" />
                </MenuFlyout>
            </ListView.ContextFlyout>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ContainerItem">
                    <table:TableRowPanel LayoutKey="containers" ColumnSpacing="12">
                        <TextBlock table:TableRowPanel.ColumnKey="name" Text="{x:Bind Info.Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Info.Name, Mode=OneWay}" />
                        <TextBlock table:TableRowPanel.ColumnKey="project" Text="{x:Bind Info.ProjectText, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Info.ProjectText, Mode=OneWay}" />
                        <TextBlock table:TableRowPanel.ColumnKey="image" Text="{x:Bind Info.Image, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Info.Image, Mode=OneWay}" />
                        <TextBlock table:TableRowPanel.ColumnKey="status" Text="{x:Bind Info.Status, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Info.Status, Mode=OneWay}" />
                        <TextBlock table:TableRowPanel.ColumnKey="ports" Text="{x:Bind Info.Ports, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Info.Ports, Mode=OneWay}" />
                        <TextBlock table:TableRowPanel.ColumnKey="created" Text="{x:Bind Info.CreatedText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <TextBlock table:TableRowPanel.ColumnKey="id" Text="{x:Bind Info.ShortId, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <TextBlock table:TableRowPanel.ColumnKey="command" Text="{x:Bind Info.Command, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Info.Command, Mode=OneWay}" />
                    </table:TableRowPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            x:Uid="Containers_EmptyText"
            Grid.Row="4"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
    </Grid>
</Page>
