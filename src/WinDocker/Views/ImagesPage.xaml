<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinDocker.Views.ImagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WinDocker.Core.Models"
    NavigationCacheMode="Required">

    <Grid Padding="16,8,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <CommandBar
            Grid.Row="0"
            HorizontalAlignment="Left"
            Background="Transparent"
            DefaultLabelPosition="Right"
            IsOpen="False"
            OverflowButtonVisibility="Collapsed">
            <AppBarButton x:Uid="Images_RefreshButton" Icon="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" />
            <AppBarSeparator />
            <AppBarButton x:Uid="Images_DeleteButton" Icon="Delete" Command="{x:Bind ViewModel.RemoveCommand}">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Delete" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton x:Uid="Images_PruneButton" Icon="Trim" Command="{x:Bind ViewModel.PruneCommand}" />
        </CommandBar>

        <ProgressBar
            Grid.Row="1"
            VerticalAlignment="Center"
            IsIndeterminate="True"
            Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

        <StackPanel Grid.Row="2">
            <InfoBar
                x:Uid="Images_ErrorInfoBar"
                Margin="0,8,0,0"
                Severity="Error"
                IsOpen="{x:Bind ViewModel.HasError, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
            <InfoBar
                x:Uid="Images_StatusInfoBar"
                Margin="0,8,0,0"
                Severity="Success"
                IsOpen="{x:Bind ViewModel.HasStatus, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
        </StackPanel>

        <Grid Grid.Row="3" Padding="12,8,12,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="Images_HeaderRepository" Grid.Column="0" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock x:Uid="Images_HeaderTag" Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock x:Uid="Images_HeaderId" Grid.Column="2" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock x:Uid="Images_HeaderCreated" Grid.Column="3" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock x:Uid="Images_HeaderSize" Grid.Column="4" Style="{StaticResource BodyStrongTextBlockStyle}" />
        </Grid>

        <ListView
            Grid.Row="4"
            ItemsSource="{x:Bind ViewModel.Images}"
            SelectionMode="Extended"
            ItemContainerStyle="{StaticResource TableRowStyle}"
            SelectionChanged="List_SelectionChanged"
            ContextRequested="List_ContextRequested">
            <ListView.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Uid="Images_MenuDelete" Icon="Delete" Command="{x:Bind ViewModel.RemoveCommand}" />
                </MenuFlyout>
            </ListView.ContextFlyout>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ImageItem">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind Info.Repository, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Info.Repository, Mode=OneWay}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Info.Tag, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Info.Tag, Mode=OneWay}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Info.ShortId, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3" Text="{x:Bind Info.CreatedText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="4" Text="{x:Bind Info.SizeText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            x:Uid="Images_EmptyText"
            Grid.Row="4"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
    </Grid>
</Page>
