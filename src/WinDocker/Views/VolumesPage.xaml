<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinDocker.Views.VolumesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WinDocker.Core.Models"
    xmlns:table="using:WinDocker.Views.Table"
    NavigationCacheMode="Required">

    <Grid Padding="16,8,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <CommandBar
            Grid.Row="0"
            HorizontalAlignment="Left"
            Background="Transparent"
            DefaultLabelPosition="Right"
            IsOpen="False"
            OverflowButtonVisibility="Collapsed">
            <AppBarButton x:Uid="Volumes_RefreshButton" Icon="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" />
            <AppBarSeparator />
            <AppBarButton x:Uid="Volumes_DeleteButton" Icon="Delete" Command="{x:Bind ViewModel.RemoveCommand}">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Delete" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton x:Uid="Volumes_PruneButton" Icon="Trim" Command="{x:Bind ViewModel.PruneCommand}" />
        </CommandBar>

        <ProgressBar
            Grid.Row="1"
            VerticalAlignment="Center"
            IsIndeterminate="True"
            Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

        <StackPanel Grid.Row="2">
            <InfoBar
                x:Uid="Volumes_ErrorInfoBar"
                Margin="0,8,0,0"
                Severity="Error"
                IsOpen="{x:Bind ViewModel.HasError, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
            <InfoBar
                x:Uid="Volumes_StatusInfoBar"
                Margin="0,8,0,0"
                Severity="Success"
                IsOpen="{x:Bind ViewModel.HasStatus, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
        </StackPanel>

        <table:TableHeader Grid.Row="3" LayoutKey="volumes" />

        <ListView
            x:Name="ItemList"
            Grid.Row="4"
            ItemsSource="{x:Bind ViewModel.Volumes}"
            SelectionMode="Extended"
            ItemContainerStyle="{StaticResource TableRowStyle}"
            SelectionChanged="List_SelectionChanged"
            ContextRequested="List_ContextRequested">
            <ListView.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Uid="Volumes_MenuDelete" Icon="Delete" Command="{x:Bind ViewModel.RemoveCommand}" />
                </MenuFlyout>
            </ListView.ContextFlyout>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:VolumeItem">
                    <table:TableRowPanel LayoutKey="volumes" ColumnSpacing="12">
                        <TextBlock table:TableRowPanel.ColumnKey="name" Text="{x:Bind Info.Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Info.Name, Mode=OneWay}" />
                        <TextBlock table:TableRowPanel.ColumnKey="driver" Text="{x:Bind Info.Driver, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <TextBlock table:TableRowPanel.ColumnKey="mountpoint" Text="{x:Bind Info.Mountpoint, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Info.Mountpoint, Mode=OneWay}" />
                        <TextBlock table:TableRowPanel.ColumnKey="created" Text="{x:Bind Info.CreatedText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    </table:TableRowPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            x:Uid="Volumes_EmptyText"
            Grid.Row="4"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
    </Grid>
</Page>
