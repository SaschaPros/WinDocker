<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinDocker.Views.VolumesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WinDocker.Core.Models"
    NavigationCacheMode="Required">

    <Grid Padding="16,8,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <CommandBar
            Grid.Row="0"
            HorizontalAlignment="Left"
            Background="Transparent"
            DefaultLabelPosition="Right"
            IsOpen="False"
            OverflowButtonVisibility="Collapsed">
            <AppBarButton x:Uid="Volumes_RefreshButton" Icon="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" />
            <AppBarSeparator />
            <AppBarButton x:Uid="Volumes_DeleteButton" Icon="Delete" Command="{x:Bind ViewModel.RemoveCommand}" />
        </CommandBar>

        <ProgressBar
            Grid.Row="1"
            VerticalAlignment="Center"
            IsIndeterminate="True"
            Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

        <InfoBar
            Grid.Row="2"
            x:Uid="Volumes_ErrorInfoBar"
            Margin="0,8,0,0"
            Severity="Error"
            IsOpen="{x:Bind ViewModel.HasError, Mode=TwoWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

        <Grid Grid.Row="3" Padding="12,8,12,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="Volumes_HeaderName" Grid.Column="0" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock x:Uid="Volumes_HeaderDriver" Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock x:Uid="Volumes_HeaderMountpoint" Grid.Column="2" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock x:Uid="Volumes_HeaderCreated" Grid.Column="3" Style="{StaticResource BodyStrongTextBlockStyle}" />
        </Grid>

        <ListView
            Grid.Row="4"
            ItemsSource="{x:Bind ViewModel.Volumes}"
            SelectedItem="{x:Bind ViewModel.SelectedVolume, Mode=TwoWay}"
            SelectionMode="Single"
            ItemContainerStyle="{StaticResource TableRowStyle}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:VolumeInfo">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Driver}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Mountpoint}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Mountpoint}" />
                        <TextBlock Grid.Column="3" Text="{x:Bind CreatedText}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            x:Uid="Volumes_EmptyText"
            Grid.Row="4"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
    </Grid>
</Page>
